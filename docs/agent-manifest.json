{
  "schema_version": "1.0",
  "product": "enterprise-change-graph",
  "purpose": "Provide deterministic, explainable enterprise change-impact analysis and release governance across connected artifacts.",
  "human_url": "https://dkharlanau.github.io/enterprise-change-graph/",
  "repository": "https://github.com/dkharlanau/enterprise-change-graph",
  "boundaries": ["not a manually curated CMDB requirement", "no opaque or invented risk scores", "do not invent missing graph links", "impact must be explainable by paths and propagation rules"],
  "capabilities": ["validate enterprise graphs", "impact and why-not analysis", "before/after review", "regression and ownership gap detection", "policy gates", "graph composition and artifact imports", "JUnit evidence ingestion", "release collision analysis", "predicted-vs-observed comparison", "GraphML/Cypher/static explorer export", "compact agent context"],
  "entrypoints": [
    {"type":"cli","command":"ecg validate <graph.yaml>"},
    {"type":"cli","command":"ecg impact <graph.yaml> --change <change-id> --explain"},
    {"type":"cli","command":"ecg why-not <graph.yaml> --change <change-id> --target <node-id>"},
    {"type":"cli","command":"ecg gate <graph.yaml> --change <change-id> --policy <policy.yaml>"},
    {"type":"cli","command":"ecg context <graph.yaml> --change <change-id>"}
  ],
  "safe_agent_loop": ["validate graph", "resolve exact change and target IDs", "run explained impact", "use why-not for contested exclusions", "derive regression/owner scope", "apply explicit policy", "return paths, gaps, and evidence separately"],
  "related": [
    {"product":"transformation-graph","relationship":"technical traceability source"},
    {"product":"process-as-code","relationship":"process artifact import"},
    {"product":"project-evidence-graph","relationship":"project evidence and release rationale"}
  ]
}
